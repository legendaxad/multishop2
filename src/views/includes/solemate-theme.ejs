<style>
  :root {
    color-scheme: light;
    --sm-ink: #171916;
    --sm-muted: #777d76;
    --sm-paper: #f4f5f1;
    --sm-card: #fff;
    --sm-line: #e6e9e2;
    --sm-lime: #d7fb55;
    --sm-green: #657d34;
    --sm-shadow: 0 16px 44px rgb(25 33 20 / 7%);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background: var(--sm-paper);
    color: var(--sm-ink);
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  .sm-admin {
    min-height: 100vh;
  }

  .sm-sidebar {
    position: fixed;
    z-index: 5;
    inset: 0 auto 0 0;
    display: flex;
    width: 248px;
    flex-direction: column;
    padding: 28px 18px;
    border-right: 1px solid var(--sm-line);
    background: var(--sm-card);
  }

  .sm-brand {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 0 10px 34px;
  }

  .sm-brand-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 12px;
    background: var(--sm-ink);
    color: var(--sm-lime);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: -1px;
  }

  .sm-brand-name {
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -0.8px;
  }

  .sm-brand-name small {
    display: block;
    margin-top: 3px;
    color: var(--sm-muted);
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .sm-nav-label {
    padding: 0 12px;
    color: #a1a69e;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.7px;
    text-transform: uppercase;
  }

  .sm-nav {
    display: grid;
    gap: 5px;
    margin-top: 12px;
  }

  .sm-nav a {
    display: flex;
    min-height: 45px;
    align-items: center;
    gap: 12px;
    padding: 0 12px;
    border-radius: 10px;
    color: #626860;
    font-size: 12px;
    font-weight: 700;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .sm-nav a:hover {
    transform: translateX(3px);
    background: #f3f5ef;
    color: var(--sm-ink);
  }

  .sm-nav a.is-active {
    background: var(--sm-ink);
    color: #fff;
  }

  .sm-nav-icon {
    display: inline-grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border-radius: 7px;
    background: rgb(23 25 22 / 6%);
    font-size: 12px;
  }

  .sm-nav a.is-active .sm-nav-icon {
    background: rgb(255 255 255 / 13%);
    color: var(--sm-lime);
  }

  .sm-sidebar-bottom {
    margin-top: auto;
  }

  .sm-admin-note {
    margin: 0 4px 16px;
    padding: 15px;
    border: 1px solid var(--sm-line);
    border-radius: 12px;
    background: #fafbf8;
  }

  .sm-admin-note strong {
    display: block;
    font-size: 11px;
  }

  .sm-admin-note p {
    margin: 6px 0 0;
    color: var(--sm-muted);
    font-size: 10px;
    line-height: 1.5;
  }

  .sm-sidebar .sm-logout {
    color: #9b534b;
  }

  .sm-workspace {
    min-height: 100vh;
    margin-left: 248px;
    padding: 0 42px 56px;
  }

  .sm-topbar {
    display: flex;
    min-height: 82px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--sm-line);
  }

  .sm-breadcrumb {
    color: var(--sm-muted);
    font-size: 11px;
  }

  .sm-breadcrumb strong {
    color: var(--sm-ink);
    font-weight: 750;
  }

  .sm-profile {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 750;
  }

  .sm-avatar {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid #d4dcbb;
    border-radius: 50%;
    background: #edf3dc;
    color: #53662b;
    font-size: 11px;
    font-weight: 900;
  }

  .sm-main {
    width: min(1200px, 100%);
    margin: 0 auto;
    padding-top: 38px;
    animation: sm-rise-in 650ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .sm-page-title {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
  }

  .sm-eyebrow {
    color: var(--sm-green);
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .sm-page-title h1 {
    margin: 8px 0 0;
    font-size: clamp(26px, 3.5vw, 38px);
    font-weight: 850;
    letter-spacing: -1.8px;
  }

  .sm-page-title p {
    margin: 7px 0 0;
    color: var(--sm-muted);
    font-size: 12px;
  }

  .sm-card {
    border: 1px solid var(--sm-line);
    border-radius: 15px;
    background: var(--sm-card);
    box-shadow: var(--sm-shadow);
  }

  .sm-welcome {
    position: relative;
    display: flex;
    min-height: 245px;
    align-items: center;
    overflow: hidden;
    padding: 38px 42px;
    background: var(--sm-ink);
    color: white;
    isolation: isolate;
  }

  .sm-welcome::before,
  .sm-welcome::after {
    position: absolute;
    z-index: -1;
    content: "";
    pointer-events: none;
  }

  .sm-welcome::before {
    inset: -180px -40px auto auto;
    width: 450px;
    height: 450px;
    border: 1px solid rgb(215 251 85 / 23%);
    border-radius: 50%;
    box-shadow: 0 0 0 34px rgb(215 251 85 / 4%),
      0 0 0 70px rgb(215 251 85 / 3%);
    animation: sm-orbit 22s linear infinite;
  }

  .sm-welcome::after {
    top: 22px;
    right: 90px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: rgb(215 251 85 / 10%);
    filter: blur(35px);
  }

  .sm-welcome-copy {
    max-width: 580px;
  }

  .sm-welcome .sm-eyebrow {
    color: var(--sm-lime);
  }

  .sm-welcome h1 {
    margin: 13px 0 9px;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 850;
    letter-spacing: -2.5px;
    line-height: 1.05;
  }

  .sm-welcome p {
    max-width: 440px;
    margin: 0;
    color: #c0c6bc;
    font-size: 12px;
    line-height: 1.7;
  }

  .sm-welcome .sm-button {
    margin-top: 22px;
  }

  .sm-button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 17px;
    border: 0;
    border-radius: 9px;
    background: var(--sm-ink);
    color: #fff;
    cursor: pointer;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.35px;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .sm-button:hover {
    transform: translateY(-2px);
    background: #30352d;
    box-shadow: 0 8px 20px rgb(23 25 22 / 15%);
    color: #fff;
  }

  .sm-button:disabled {
    cursor: wait;
    opacity: 0.65;
    transform: none;
  }

  .sm-button--lime {
    background: var(--sm-lime);
    color: var(--sm-ink);
  }

  .sm-button--lime:hover {
    background: #c6eb42;
    color: var(--sm-ink);
  }

  .sm-button--light {
    border: 1px solid var(--sm-line);
    background: white;
    color: var(--sm-ink);
  }

  .sm-button--light:hover {
    background: #f5f6f2;
    color: var(--sm-ink);
  }

  .sm-section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin: 30px 0 14px;
  }

  .sm-section-heading h2 {
    margin: 0;
    font-size: 14px;
    font-weight: 850;
    letter-spacing: -0.3px;
  }

  .sm-section-heading span,
  .sm-section-heading a {
    color: var(--sm-muted);
    font-size: 10px;
  }

  .sm-action-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13px;
  }

  .sm-action-card {
    position: relative;
    display: flex;
    min-height: 116px;
    align-items: center;
    gap: 16px;
    overflow: hidden;
    padding: 20px;
    animation: sm-rise-in 600ms both;
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  }

  .sm-action-card::after {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: radial-gradient(
      240px circle at var(--pointer-x, 50%) var(--pointer-y, 50%),
      rgb(215 251 85 / 13%),
      transparent 72%
    );
    content: "";
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .sm-action-card:hover {
    transform: translateY(-4px);
    border-color: #d0d8c0;
    box-shadow: 0 18px 35px rgb(25 33 20 / 10%);
  }

  .sm-action-card:hover::after {
    opacity: 1;
  }

  .sm-action-icon {
    display: grid;
    width: 46px;
    height: 46px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 13px;
    background: #f0f4e6;
    color: #596d2e;
    font-size: 20px;
    transition: transform 220ms ease;
  }

  .sm-action-card > span {
    position: relative;
    z-index: 1;
  }

  .sm-action-card:hover .sm-action-icon {
    transform: rotate(-8deg) scale(1.06);
  }

  .sm-action-card strong {
    display: block;
    font-size: 12px;
    font-weight: 850;
  }

  .sm-action-card p {
    margin: 6px 0 0;
    color: var(--sm-muted);
    font-size: 10px;
    line-height: 1.5;
  }

  .sm-action-arrow {
    margin-left: auto;
    color: #989e94;
    font-size: 17px;
  }

  .sm-table-card {
    overflow: hidden;
  }

  .sm-table-scroll {
    overflow-x: auto;
  }

  .sm-table {
    width: 100%;
    min-width: 680px;
    margin: 0;
    border-collapse: collapse;
    color: var(--sm-ink);
  }

  .sm-table th {
    padding: 13px 16px;
    border: 0;
    border-bottom: 1px solid var(--sm-line);
    background: #fafbf8;
    color: #858c82;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 1px;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .sm-table td {
    padding: 14px 16px;
    border-top: 1px solid #f0f1ed;
    font-size: 11px;
    vertical-align: middle;
  }

  .sm-table tbody tr {
    animation: sm-rise-in 450ms both;
    transition: background 160ms ease;
  }

  .sm-table tbody tr:hover {
    background: #fafbf7;
  }

  .sm-table td strong {
    font-weight: 800;
  }

  .sm-table select {
    min-height: 32px;
    padding: 0 9px;
    border: 1px solid var(--sm-line);
    border-radius: 7px;
    background: #fff;
    color: var(--sm-ink);
    font-size: 10px;
  }

  .sm-index {
    color: #a0a69c;
    font-size: 10px !important;
    font-weight: 800;
  }

  .sm-stock {
    display: inline-flex;
    min-width: 28px;
    min-height: 25px;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: #f0f4e6;
    color: #53652d;
    font-size: 10px;
    font-weight: 850;
  }

  .sm-form-card {
    margin-top: 25px;
    padding: 25px;
  }

  .sm-form-heading {
    margin-bottom: 20px;
  }

  .sm-form-heading h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 850;
    letter-spacing: -0.5px;
  }

  .sm-form-heading p {
    margin: 6px 0 0;
    color: var(--sm-muted);
    font-size: 10px;
  }

  .sm-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
  }

  .sm-field {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 7px;
  }

  .sm-field--full {
    grid-column: 1 / -1;
  }

  .sm-field label {
    color: #50574f;
    font-size: 10px;
    font-weight: 800;
  }

  .sm-field input,
  .sm-field select,
  .sm-field textarea {
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    border: 1px solid var(--sm-line);
    border-radius: 8px;
    outline: none;
    background: #fbfcfa;
    color: var(--sm-ink);
    font-size: 11px;
    transition: border 150ms ease, box-shadow 150ms ease, background 150ms ease;
  }

  .sm-field textarea {
    min-height: 100px;
    resize: vertical;
  }

  .sm-field input:focus,
  .sm-field select:focus,
  .sm-field textarea:focus {
    border-color: #a8bd6c;
    background: #fff;
    box-shadow: 0 0 0 3px rgb(158 190 83 / 15%);
  }

  .sm-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 9px;
    margin-top: 18px;
  }

  .sm-file-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 9px;
  }

  .sm-file-tile {
    position: relative;
    display: grid;
    min-height: 82px;
    place-items: center;
    overflow: hidden;
    border: 1px dashed #cbd1c3;
    border-radius: 10px;
    background: #fafbf8;
    color: #7c8478;
    font-size: 9px;
    text-align: center;
    transition: background 160ms ease, border-color 160ms ease;
  }

  .sm-file-tile:hover {
    border-color: #98ad60;
    background: #f3f7e9;
  }

  .sm-file-tile input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .sm-file-tile span {
    display: grid;
    gap: 4px;
    pointer-events: none;
  }

  .sm-file-tile b {
    color: #546536;
    font-size: 17px;
  }

  .sm-empty {
    padding: 36px 18px !important;
    color: var(--sm-muted);
    text-align: center;
  }

  .sm-notice {
    padding: 22px;
    border: 1px solid var(--sm-line);
    border-radius: 13px;
    background: #fff;
    color: var(--sm-muted);
    font-size: 12px;
  }

  .sm-auth {
    display: grid;
    min-height: 100vh;
    grid-template-columns: minmax(280px, 0.85fr) 1.15fr;
    background: #fff;
  }

  .sm-auth-panel {
    position: relative;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: 34px;
    background: #1d211b;
    color: #fff;
    isolation: isolate;
  }

  .sm-auth-panel::before,
  .sm-auth-panel::after {
    position: absolute;
    z-index: -1;
    content: "";
    pointer-events: none;
  }

  .sm-auth-panel::before {
    right: -115px;
    bottom: 5%;
    width: 410px;
    height: 410px;
    border: 1px solid rgb(215 251 85 / 28%);
    border-radius: 50%;
    box-shadow: 0 0 0 35px rgb(215 251 85 / 4%),
      0 0 0 75px rgb(215 251 85 / 3%);
    animation: sm-orbit 24s linear infinite;
  }

  .sm-auth-panel::after {
    right: 0;
    bottom: 22%;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: rgb(215 251 85 / 14%);
    filter: blur(55px);
    animation: sm-glow 6s ease-in-out infinite alternate;
  }

  .sm-auth-panel .sm-brand {
    padding: 0;
  }

  .sm-auth-panel .sm-brand-name small {
    color: #aab0a3;
  }

  .sm-auth-story {
    position: relative;
    max-width: 380px;
    margin: auto 0 22px;
  }

  .sm-auth-story .sm-eyebrow {
    color: var(--sm-lime);
  }

  .sm-auth-story h1 {
    margin: 14px 0;
    font-size: clamp(34px, 5vw, 58px);
    font-weight: 900;
    letter-spacing: -3px;
    line-height: 0.99;
  }

  .sm-auth-story p {
    max-width: 330px;
    margin: 0;
    color: #c2c8bd;
    font-size: 12px;
    line-height: 1.7;
  }

  .sm-auth-stamp {
    position: absolute;
    right: -8px;
    bottom: 4px;
    display: grid;
    width: 100px;
    height: 100px;
    place-items: center;
    border: 1px solid rgb(215 251 85 / 40%);
    border-radius: 50%;
    color: var(--sm-lime);
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 1.2px;
    text-align: center;
    transform: rotate(12deg);
    animation: sm-float 4s ease-in-out infinite;
  }

  .sm-auth-side {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: 40px 24px;
    background: var(--sm-paper);
  }

  .sm-auth-card {
    width: min(100%, 460px);
    padding: 36px;
    border: 1px solid var(--sm-line);
    border-radius: 17px;
    background: #fff;
    box-shadow: 0 22px 65px rgb(25 33 20 / 8%);
    animation: sm-rise-in 700ms 100ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .sm-auth-card h2 {
    margin: 0;
    font-size: 27px;
    font-weight: 900;
    letter-spacing: -1.2px;
  }

  .sm-auth-card .sm-auth-intro {
    margin: 8px 0 23px;
    color: var(--sm-muted);
    font-size: 11px;
    line-height: 1.6;
  }

  .sm-auth-card .sm-field {
    margin-top: 15px;
  }

  .sm-auth-card .sm-field input {
    min-height: 46px;
  }

  .sm-auth-card .sm-button {
    width: 100%;
    min-height: 46px;
    margin-top: 21px;
  }

  .sm-auth-meta {
    margin: 18px 0 0;
    color: var(--sm-muted);
    font-size: 10px;
    text-align: center;
  }

  .sm-auth-meta a {
    color: var(--sm-green);
    font-weight: 850;
  }

  .sm-image-upload {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 20px;
    padding: 12px;
    border: 1px dashed #cbd1c3;
    border-radius: 10px;
    background: #fafbf8;
  }

  .sm-image-preview {
    width: 64px;
    height: 64px;
    flex: 0 0 auto;
    border-radius: 9px;
    background: #e8ebdf;
    object-fit: cover;
  }

  .sm-upload-control {
    min-width: 0;
  }

  .sm-upload-control label {
    display: block;
    margin-bottom: 5px;
    font-size: 10px;
    font-weight: 800;
  }

  .sm-upload-control input[type="file"] {
    width: 100%;
    color: var(--sm-muted);
    font-size: 9px;
  }

  .sm-upload-control p {
    margin: 5px 0 0;
    color: var(--sm-muted);
    font-size: 9px;
  }

  @keyframes sm-rise-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes sm-orbit {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes sm-glow {
    to {
      opacity: 0.45;
      transform: scale(1.18);
    }
  }

  @keyframes sm-float {
    50% {
      transform: translateY(-7px) rotate(7deg);
    }
  }

  @media (max-width: 900px) {
    .sm-sidebar {
      width: 210px;
    }

    .sm-workspace {
      margin-left: 210px;
      padding-right: 24px;
      padding-left: 24px;
    }

    .sm-auth {
      grid-template-columns: 0.75fr 1.25fr;
    }

    .sm-auth-panel {
      padding: 26px;
    }

    .sm-auth-stamp {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .sm-sidebar {
      position: relative;
      inset: auto;
      width: 100%;
      padding: 12px 16px;
      border-right: 0;
      border-bottom: 1px solid var(--sm-line);
    }

    .sm-brand {
      padding: 0 2px 11px;
    }

    .sm-nav-label,
    .sm-sidebar-bottom,
    .sm-nav-icon {
      display: none;
    }

    .sm-nav {
      display: flex;
      gap: 5px;
      overflow-x: auto;
      margin: 0;
      padding-bottom: 2px;
    }

    .sm-nav a {
      min-height: 35px;
      flex: 0 0 auto;
      padding: 0 11px;
      font-size: 10px;
    }

    .sm-workspace {
      min-height: 0;
      margin-left: 0;
      padding: 0 16px 35px;
    }

    .sm-topbar {
      min-height: 55px;
    }

    .sm-main {
      padding-top: 24px;
    }

    .sm-welcome {
      min-height: 220px;
      padding: 25px;
    }

    .sm-action-grid {
      grid-template-columns: 1fr;
    }

    .sm-page-title {
