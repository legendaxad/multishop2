<%- include('includes/header') %>
<%- include('includes/solemate-theme') %>

<body>
  <div class="sm-admin">
    <aside class="sm-sidebar">
      <a class="sm-brand" href="/admin">
        <span class="sm-brand-mark">SM</span>
        <span class="sm-brand-name">SoleMate<small>Store admin</small></span>
      </a>
      <span class="sm-nav-label">Workspace</span>
      <nav class="sm-nav" aria-label="Admin navigation">
        <a href="/admin"><span class="sm-nav-icon">⌂</span>Overview</a>
        <a class="is-active" href="/admin/product/all"><span class="sm-nav-icon">◈</span>Sneaker inventory</a>
        <a href="/admin/user/all"><span class="sm-nav-icon">◎</span>Customers</a>
      </nav>
      <div class="sm-sidebar-bottom">
        <div class="sm-admin-note">
          <strong>Stay in the loop.</strong>
          <p>Keep product details and availability current for your store.</p>
        </div>
        <nav class="sm-nav" aria-label="Account navigation">
          <a class="sm-logout" href="/admin/logout" onclick="return confirm('Do you want to log out?')"><span class="sm-nav-icon">↗</span>Log out</a>
        </nav>
      </div>
    </aside>

    <div class="sm-workspace">
      <header class="sm-topbar">
        <div class="sm-breadcrumb">Workspace <span>/</span> <strong>Sneaker inventory</strong></div>
        <div class="sm-profile">
          <span class="sm-avatar"><%= typeof member !== "undefined" && member && member.memberNick ? member.memberNick.charAt(0).toUpperCase() : 'SM' %></span>
          <span><%= typeof member !== "undefined" && member && member.memberNick ? member.memberNick : 'SoleMate Admin' %></span>
        </div>
      </header>

      <main class="sm-main">
        <header class="sm-page-title">
          <div>
            <span class="sm-eyebrow">Catalog management</span>
            <h1>Sneaker inventory</h1>
            <p>Manage products, stock, and listing status.</p>
          </div>
          <a class="sm-button" href="#new-product">＋ ADD SNEAKER</a>
        </header>

        <section class="sm-card sm-table-card" aria-label="Sneaker inventory">
          <div class="sm-table-scroll">
            <table class="sm-table">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Sneaker</th>
                  <th scope="col">Brand</th>
                  <th scope="col">Category</th>
                  <th scope="col">Price</th>
                  <th scope="col">Pairs in stock</th>
                  <th scope="col">Listing status</th>
                </tr>
              </thead>
              <tbody>
                <% if (products.length) { %>
                  <% products.forEach((product, index) => { %>
                  <tr>
                    <td class="sm-index"><%= String(index + 1).padStart(2, "0") %></td>
                    <td><strong><%= product.productName %></strong></td>
                    <td><%= product.productBrand %></td>
                    <td><%= product.productCategory %></td>
                    <td><%= product.productPrice %></td>
                    <td><span class="sm-stock"><%= product.productLeftCount %></span></td>
                    <td>
                      <select class="new-product-status" data-id="<%= product._id %>" aria-label="Listing status for <%= product.productName %>">
                        <option value="PAUSE" <%= product.productStatus === 'PAUSE' ? 'selected' : '' %>>PAUSED</option>
                        <option value="PROCESS" <%= product.productStatus === 'PROCESS' ? 'selected' : '' %>>ACTIVE</option>
                        <option value="DELETE" <%= product.productStatus === 'DELETE' ? 'selected' : '' %>>DELETED</option>
                      </select>
                    </td>
                  </tr>
                  <% }); %>
                <% } else { %>
                <tr>
                  <td class="sm-empty" colspan="7">No sneakers yet. Add your first pair below.</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

        <form
          id="new-product"
          action="/admin/product/create"
          method="POST"
          class="sm-card sm-form-card"
          enctype="multipart/form-data"
        >
          <div class="sm-form-heading">
            <h2>Add a sneaker</h2>
            <p>Enter product details, available EU sizes, and up to five images.</p>
          </div>
          <div class="sm-form-grid">
            <div class="sm-field">
              <label for="product-name">Sneaker name *</label>
              <input id="product-name" type="text" name="productName" placeholder="e.g. Air Runner 01" required />
            </div>
            <div class="sm-field">
              <label for="product-brand">Brand *</label>
              <input id="product-brand" type="text" name="productBrand" placeholder="e.g. Nike" required />
            </div>
            <div class="sm-field">
              <label for="product-price">Price *</label>
              <input id="product-price" type="number" name="productPrice" placeholder="Price" min="0" step="0.01" required />
            </div>
            <div class="sm-field">
              <label for="product-count">Pairs in stock *</label>
              <input id="product-count" type="number" name="productLeftCount" placeholder="Quantity" min="0" step="1" required />
            </div>
            <div class="sm-field">
              <label for="product-category">Category *</label>
              <select id="product-category" name="productCategory" required>
                <option value="RUNNING">Running</option>
                <option value="CASUAL" selected>Casual</option>
                <option value="BASKETBALL">Basketball</option>
                <option value="FOOTBALL">Football</option>
                <option value="TRAINING">Training</option>
                <option value="LIFESTYLE">Lifestyle</option>
                <option value="OTHER">Other</option>
              </select>
            </div>
            <div class="sm-field">
              <label for="product-sizes">Available EU sizes *</label>
              <input id="product-sizes" type="text" name="productSizes" placeholder="38, 39, 40, 41" required />
            </div>
            <div class="sm-field sm-field--full">
              <label for="product-description">Description *</label>
              <textarea id="product-description" name="productDesc" placeholder="Materials, fit, and what makes this pair special..." required></textarea>
            </div>
            <div class="sm-field sm-field--full">
              <label>Product images (first image required)</label>
              <div class="sm-file-grid">
                <% [1, 2, 3, 4, 5].forEach((imageNumber) => { %>
                <label class="sm-file-tile">
                  <span><b>＋</b><%= imageNumber === 1 ? 'Cover image *' : `Image ${imageNumber}` %></span>
                  <input
                    type="file"
                    name="productImages"
                    accept="image/*"
                    <%= imageNumber === 1 ? 'required' : '' %>
                  />
                </label>
                <% }); %>
              </div>
            </div>
          </div>
          <input name="productStatus" value="PAUSE" hidden />
          <div class="sm-form-actions">
            <button type="reset" class="sm-button sm-button--light">CLEAR FORM</button>
            <button type="submit" class="sm-button sm-button--lime">CREATE SNEAKER</button>
          </div>
        </form>
      </main>
    </div>
  </div>
  <script src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
