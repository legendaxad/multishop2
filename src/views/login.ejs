<%- include('includes/header') %>
<%- include('includes/solemate-theme') %>

<body>
  <main class="sm-auth">
    <aside class="sm-auth-panel">
      <a class="sm-brand" href="/admin">
        <span class="sm-brand-mark">SM</span>
        <span class="sm-brand-name">SoleMate<small>Store admin</small></span>
      </a>
      <div class="sm-auth-story">
        <span class="sm-eyebrow">The SoleMate workspace</span>
        <h1>Your store.<br />Your next move.</h1>
        <p>
          Sign in to keep your sneaker listings and customer accounts in good
          shape.
        </p>
        <span class="sm-auth-stamp" aria-hidden="true">STEP INTO<br />YOUR STORE</span>
      </div>
    </aside>

    <section class="sm-auth-side">
      <form class="sm-auth-card" action="/admin/login" method="POST">
        <span class="sm-eyebrow">Store administration</span>
        <h2>Welcome back.</h2>
        <p class="sm-auth-intro">Sign in with your SoleMate admin credentials.</p>

        <div class="sm-field">
          <label for="member-identity">Shop name</label>
          <input
            id="member-identity"
            type="text"
            name="memberIdentity"
            class="member-nick"
            placeholder="Enter your shop name"
            autocomplete="username"
            required
          />
        </div>
        <div class="sm-field">
          <label for="member-password">Password</label>
          <input
            id="member-password"
            type="password"
            name="memberPassword"
            class="member-password"
            placeholder="Enter your password"
            autocomplete="current-password"
            required
          />
        </div>

        <button class="sm-button sm-button--lime" name="login" type="submit">SIGN IN TO ADMIN</button>
        <p class="sm-auth-meta">
          Need a store account? <a href="/admin/signup">Create one</a>
          <br /><a href="/admin">Back to admin home</a>
        </p>
      </form>
    </section>
  </main>
  <script src="/js/login.js"></script>
</body>

<%- include('includes/footer') %>
