<%- include('includes/header') %>
<%- include('includes/solemate-theme') %>

<body>
  <div class="sm-admin">
    <aside class="sm-sidebar">
      <a class="sm-brand" href="/admin">
        <span class="sm-brand-mark">SM</span>
        <span class="sm-brand-name">SoleMate<small>Store admin</small></span>
      </a>
      <span class="sm-nav-label">Workspace</span>
      <nav class="sm-nav" aria-label="Admin navigation">
        <a href="/admin"><span class="sm-nav-icon">⌂</span>Overview</a>
        <a href="/admin/product/all"><span class="sm-nav-icon">◈</span>Sneaker inventory</a>
        <a class="is-active" href="/admin/user/all"><span class="sm-nav-icon">◎</span>Customers</a>
      </nav>
      <div class="sm-sidebar-bottom">
        <div class="sm-admin-note">
          <strong>Customer accounts</strong>
          <p>View customer contact details and manage account status.</p>
        </div>
        <nav class="sm-nav" aria-label="Account navigation">
          <a class="sm-logout" href="/admin/logout" onclick="return confirm('Do you want to log out?')"><span class="sm-nav-icon">↗</span>Log out</a>
        </nav>
      </div>
    </aside>

    <div class="sm-workspace">
      <header class="sm-topbar">
        <div class="sm-breadcrumb">Workspace <span>/</span> <strong>Customers</strong></div>
        <div class="sm-profile">
          <span class="sm-avatar"><%= typeof member !== "undefined" && member && member.memberNick ? member.memberNick.charAt(0).toUpperCase() : 'SM' %></span>
          <span><%= typeof member !== "undefined" && member && member.memberNick ? member.memberNick : 'SoleMate Admin' %></span>
        </div>
      </header>

      <main class="sm-main">
        <% if (typeof member === "undefined" || !member) { %>
        <header class="sm-page-title">
          <div>
            <span class="sm-eyebrow">Store administration</span>
            <h1>Customer accounts</h1>
            <p>Sign in to view and manage customer accounts.</p>
          </div>
        </header>
        <div class="sm-notice">
          You need to sign in before accessing customer account details.
          <a class="sm-button" href="/admin/login" style="margin-left: 12px">SIGN IN</a>
        </div>
        <% } else { %>
        <header class="sm-page-title">
          <div>
            <span class="sm-eyebrow">Account management</span>
            <h1>Customer accounts</h1>
            <p>Review customer details and manage account status.</p>
          </div>
        </header>

        <section class="sm-card sm-table-card" aria-label="Customer accounts">
          <div class="sm-table-scroll">
            <table class="sm-table">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Customer</th>
                  <th scope="col">Phone</th>
                  <th scope="col">Account status</th>
                </tr>
              </thead>
              <tbody>
                <% if (users.length) { %>
                  <% users.forEach((user, index) => { %>
                  <tr>
                    <td class="sm-index"><%= String(index + 1).padStart(2, "0") %></td>
                    <td><strong><%= user.memberNick %></strong></td>
                    <td><%= user.memberPhone %></td>
                    <td>
                      <select class="member-status" data-id="<%= user._id %>" aria-label="Status for <%= user.memberNick %>">
                        <option value="ACTIVE" <%= user.memberStatus === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                        <option value="BLOCK" <%= user.memberStatus === 'BLOCK' ? 'selected' : '' %>>BLOCKED</option>
                        <option value="DELETE" <%= user.memberStatus === 'DELETE' ? 'selected' : '' %>>DELETED</option>
                      </select>
                    </td>
                  </tr>
                  <% }); %>
                <% } else { %>
                <tr>
                  <td class="sm-empty" colspan="4">No customer accounts to display.</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
        <% } %>
      </main>
    </div>
  </div>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>
