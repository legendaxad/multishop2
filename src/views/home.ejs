<%- include('includes/header') %>
<%- include('includes/solemate-theme') %>

<body>
  <div class="sm-admin">
    <aside class="sm-sidebar">
      <a class="sm-brand" href="/admin">
        <span class="sm-brand-mark">SM</span>
        <span class="sm-brand-name">SoleMate<small>Store admin</small></span>
      </a>
      <span class="sm-nav-label">Workspace</span>
      <nav class="sm-nav" aria-label="Admin navigation">
        <a class="is-active" href="/admin"><span class="sm-nav-icon">⌂</span>Overview</a>
        <% if (typeof member !== "undefined" && member) { %>
        <a href="/admin/product/all"><span class="sm-nav-icon">◈</span>Sneaker inventory</a>
        <a href="/admin/user/all"><span class="sm-nav-icon">◎</span>Customers</a>
        <a class="sm-logout" href="/admin/logout" onclick="return confirm('Do you want to log out?')"><span class="sm-nav-icon">↗</span>Log out</a>
        <% } else { %>
        <a href="/admin/login"><span class="sm-nav-icon">↗</span>Sign in</a>
        <a href="/admin/signup"><span class="sm-nav-icon">＋</span>Create account</a>
        <% } %>
      </nav>
      <div class="sm-sidebar-bottom">
        <div class="sm-admin-note">
          <strong>Your store, in step.</strong>
          <p>Manage sneaker listings and customer accounts from one place.</p>
        </div>
      </div>
    </aside>

    <div class="sm-workspace">
      <header class="sm-topbar">
        <div class="sm-breadcrumb">SoleMate <span>/</span> <strong>Overview</strong></div>
        <% if (typeof member !== "undefined" && member) { %>
        <div class="sm-profile">
          <span class="sm-avatar"><%= member.memberNick.charAt(0).toUpperCase() %></span>
          <span><%= member.memberNick %></span>
        </div>
        <% } else { %>
        <a class="sm-button sm-button--light" href="/admin/login">Admin sign in</a>
        <% } %>
      </header>

      <main class="sm-main">
        <% if (typeof member !== "undefined" && member) { %>
        <section class="sm-welcome">
          <div class="sm-welcome-copy">
            <span class="sm-eyebrow">Store control center</span>
            <h1>Good to have you back, <%= member.memberNick %>.</h1>
            <p>
              Your admin workspace is ready. Update sneaker listings, review
              stock, and manage customer accounts.
            </p>
            <a class="sm-button sm-button--lime" href="/admin/product/all">OPEN SNEAKER INVENTORY <span>↗</span></a>
          </div>
        </section>

        <div class="sm-section-heading">
          <h2>Quick actions</h2>
          <span>Manage your store</span>
        </div>
        <section class="sm-action-grid" aria-label="Store management shortcuts">
          <a class="sm-card sm-action-card" href="/admin/product/all">
            <span class="sm-action-icon">◈</span>
            <span>
              <strong>Sneaker inventory</strong>
              <p>Add pairs, update product details, and manage listing status.</p>
            </span>
            <span class="sm-action-arrow">↗</span>
          </a>
          <a class="sm-card sm-action-card" href="/admin/user/all">
            <span class="sm-action-icon">◎</span>
            <span>
              <strong>Customer accounts</strong>
              <p>Review customer details and manage account status.</p>
            </span>
            <span class="sm-action-arrow">↗</span>
          </a>
        </section>
        <% } else { %>
        <section class="sm-welcome">
          <div class="sm-welcome-copy">
            <span class="sm-eyebrow">SoleMate / Admin portal</span>
            <h1>A better view<br />of your store.</h1>
            <p>
              Sign in to manage your sneaker inventory and customer accounts,
              or create an admin account to get started.
            </p>
            <a class="sm-button sm-button--lime" href="/admin/login">SIGN IN TO YOUR STORE <span>↗</span></a>
          </div>
        </section>
        <div class="sm-section-heading">
          <h2>Get started</h2>
          <span>Store admin tools</span>
        </div>
        <section class="sm-action-grid">
          <a class="sm-card sm-action-card" href="/admin/login">
            <span class="sm-action-icon">↗</span>
            <span>
              <strong>Sign in to your store</strong>
              <p>Pick up where you left off in your SoleMate workspace.</p>
            </span>
            <span class="sm-action-arrow">↗</span>
          </a>
          <a class="sm-card sm-action-card" href="/admin/signup">
            <span class="sm-action-icon">＋</span>
            <span>
              <strong>Create an admin account</strong>
              <p>Set up your store profile and open your admin workspace.</p>
            </span>
            <span class="sm-action-arrow">↗</span>
          </a>
        </section>
        <% } %>
      </main>
    </div>
  </div>
  <script src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
